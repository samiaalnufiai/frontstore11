<div class="sticky top-0 z-50">
  {# Announcement Bar #}
  {% if settings.announcement_bar_display and settings.announcement_bar_text %}
    <div class="asrar-announcement-bar">
      <div class="asrar-announcement-inner">
        <span class="asrar-ornament">✦</span>
        <p>{{ settings.announcement_bar_text }}</p>
        <span class="asrar-ornament">✦</span>
      </div>
    </div>
  {% endif %}

  <header class="asrar-header">
    <nav class="asrar-nav">

      {# Mobile Menu Toggle #}
      <button
        class="asrar-icon-btn lg:hidden"
        id="mobile-menu-toggle"
        aria-label="{{ _('Menu') }}"
        onclick="document.getElementById('mobile-drawer').classList.toggle('open')"
      >
        <svg width="22" height="16" viewBox="0 0 22 16" fill="none">
          <line x1="0" y1="1" x2="22" y2="1" stroke="currentColor" stroke-width="1.5"/>
          <line x1="4" y1="8" x2="22" y2="8" stroke="currentColor" stroke-width="1.5"/>
          <line x1="8" y1="15" x2="22" y2="15" stroke="currentColor" stroke-width="1.5"/>
        </svg>
      </button>

      {# Logo #}
      <div class="asrar-nav-logo">
        <a href="/" aria-label="{{ _('Home') }}" class="asrar-logo-link">
          {% if settings.logo_desktop %}
            <img
              src="{{ image_url(settings.logo_desktop, w=220, q=95, f='auto') }}"
              alt="{{ store.name }}"
              class="asrar-logo-img hidden md:block"
              width="110" height="44"
            />
          {% endif %}
          {% if settings.logo_mobile %}
            <img
              src="{{ image_url(settings.logo_mobile, w=140, q=95, f='auto') }}"
              alt="{{ store.name }}"
              class="asrar-logo-img block md:hidden"
              width="70" height="28"
            />
          {% elif settings.logo_desktop %}
            <img
              src="{{ image_url(settings.logo_desktop, w=140, q=95, f='auto') }}"
              alt="{{ store.name }}"
              class="asrar-logo-img block md:hidden"
              width="70" height="28"
            />
          {% else %}
            <span class="asrar-logo-text">{{ store.name }}</span>
          {% endif %}
        </a>
      </div>

      {# Desktop Navigation #}
      <ul class="asrar-main-nav hidden lg:flex">
        {% for item in safeget(settings, 'nav_items', []) %}
          <li>
            <a href="{{ item.url | default('#') }}" class="asrar-nav-link">{{ item.title }}</a>
          </li>
        {% endfor %}
        {# Fallback nav if no custom items configured #}
        {% if not settings.nav_items %}
          <li><a href="{{ url_for('home') }}" class="asrar-nav-link">{{ _('Home') }}</a></li>
          <li><a href="{{ url_for('list_products') }}" class="asrar-nav-link">{{ _('Products') }}</a></li>
          <li><a href="{{ url_for('list_categories') }}" class="asrar-nav-link">{{ _('Categories') }}</a></li>
        {% endif %}
      </ul>

      {# Right Actions #}
      <ul class="asrar-nav-actions">

        {# Search #}
        <li>
          <button class="asrar-icon-btn" id="search-toggle" aria-label="{{ _('Search') }}" onclick="document.getElementById('search-overlay').classList.toggle('open')">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.25"/>
              <path d="M14 14L18 18" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
            </svg>
          </button>
        </li>

        {# Account #}
        <li class="hidden lg:block">
          <button
            id="header-login-btn"
            type="button"
            onclick="handleLoginAction()"
            class="asrar-icon-btn"
            aria-label="{{ _('Login') }}"
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <circle cx="10" cy="7" r="3.5" stroke="currentColor" stroke-width="1.25"/>
              <path d="M3 18c0-3.866 3.134-7 7-7s7 3.134 7 7" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
            </svg>
          </button>
          <a
            id="header-profile-btn"
            href="{{ url_for('profile') }}"
            class="asrar-icon-btn hidden"
            aria-label="{{ _('Profile') }}"
          >
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <circle cx="10" cy="7" r="3.5" stroke="currentColor" stroke-width="1.25"/>
              <path d="M3 18c0-3.866 3.134-7 7-7s7 3.134 7 7" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
            </svg>
          </a>
        </li>

        {# Cart #}
        <li>
          <a href="{{ url_for('cart_page') }}" class="asrar-icon-btn asrar-cart-btn" aria-label="{{ _('Cart') }}">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M7 7V5.5a3 3 0 016 0V7" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
              <rect x="2.5" y="7" width="15" height="11.5" rx="1" stroke="currentColor" stroke-width="1.25"/>
            </svg>
            <span
              data-cart-badge
              hidden
              class="asrar-cart-badge"
            >0</span>
          </a>
        </li>

      </ul>
    </nav>
  </header>
</div>

{# Search Overlay #}
<div id="search-overlay" class="asrar-search-overlay">
  <div class="asrar-search-container">
    <div class="asrar-search-inner">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" class="asrar-search-icon">
        <circle cx="9" cy="9" r="6.5" stroke="currentColor" stroke-width="1.25"/>
        <path d="M14 14L18 18" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
      </svg>
      <input
        type="text"
        placeholder="{{ _('Search...') }}"
        class="asrar-search-input"
        id="search-input"
        autofocus
        oninput="if(this.value.length > 1) window.location.href='/search?q=' + encodeURIComponent(this.value)"
      />
      <button
        class="asrar-search-close"
        onclick="document.getElementById('search-overlay').classList.remove('open')"
        aria-label="{{ _('Close') }}"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>
</div>

{# Mobile Drawer #}
<div id="mobile-drawer" class="asrar-mobile-drawer">
  <div class="asrar-mobile-drawer-inner">
    <div class="asrar-mobile-drawer-header">
      <span class="asrar-logo-text">{{ store.name }}</span>
      <button
        class="asrar-icon-btn"
        onclick="document.getElementById('mobile-drawer').classList.remove('open')"
        aria-label="{{ _('Close') }}"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.25" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <nav class="asrar-mobile-nav">
      {% for item in safeget(settings, 'nav_items', []) %}
        <a href="{{ item.url | default('#') }}" class="asrar-mobile-nav-link">{{ item.title }}</a>
      {% endfor %}
      {% if not settings.nav_items %}
        <a href="{{ url_for('home') }}" class="asrar-mobile-nav-link">{{ _('Home') }}</a>
        <a href="{{ url_for('list_products') }}" class="asrar-mobile-nav-link">{{ _('Products') }}</a>
        <a href="{{ url_for('list_categories') }}" class="asrar-mobile-nav-link">{{ _('Categories') }}</a>
      {% endif %}
    </nav>
    <div class="asrar-mobile-drawer-footer">
      <a href="{{ url_for('cart_page') }}" class="asrar-btn asrar-btn-gold asrar-btn-full">
        {{ _('View Cart') }}
      </a>
    </div>
  </div>
  <div class="asrar-mobile-drawer-backdrop" onclick="document.getElementById('mobile-drawer').classList.remove('open')"></div>
</div>
