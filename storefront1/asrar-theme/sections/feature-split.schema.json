{
  "template": "sections/feature-split.jinja",
  "name": { "ar": "قسم مقسوم", "en": "Feature Split" },
  "settings": [
    { "id": "image", "type": "image", "label": { "ar": "الصورة", "en": "Image" } },
    {
      "id": "image_position",
      "type": "select",
      "label": { "ar": "موضع الصورة", "en": "Image Position" },
      "options": [
        { "value": "left", "label": { "ar": "يسار", "en": "Left" } },
        { "value": "right", "label": { "ar": "يمين", "en": "Right" } }
      ],
      "default": "left"
    },
    { "id": "badge_text", "type": "text", "label": { "ar": "نص بطاقة الصورة", "en": "Image Badge Text" } },
    { "id": "eyebrow", "type": "text", "label": { "ar": "العنوان الصغير", "en": "Eyebrow" } },
    { "id": "heading", "type": "text", "label": { "ar": "العنوان الرئيسي", "en": "Heading" }, "default": "كل ملف... قصة، وفهم، وتركيبة مدروسة" },
    { "id": "description", "type": "textarea", "label": { "ar": "الوصف", "en": "Description" }, "default": "نؤمن أن العناية الحقيقية تبدأ بالفهم لا بالتقليد." },
    { "id": "features", "type": "textarea", "label": { "ar": "قائمة المميزات (سطر لكل ميزة)", "en": "Features List (one per line)" }, "default": "مكونات طبيعية وآمنة\nجرعات واضحة وسهلة\nنتائج واقعية من التراكم\nمناسبة لطبيعتك وظروفك" },
    { "id": "button_text", "type": "text", "label": { "ar": "نص الزر", "en": "Button Text" }, "default": "اعرفي أكثر عن عالمنا" },
    { "id": "button_url", "type": "url", "label": { "ar": "رابط الزر", "en": "Button URL" } }
  ]
