{% if settings.products and settings.products.results %}
  <section section-id="{{ sectionId }}" class="asrar-section" style="background:{{ 'var(--background-elevated)' if settings.dark_bg else 'var(--background)' }}">
    <div class="asrar-container">

      {# Section Header #}
      <div class="asrar-section-header">
        <div>
          {% if settings.title %}
            <h2 class="asrar-section-title">{{ settings.title }}</h2>
            <span class="asrar-section-ornament"></span>
          {% endif %}
        </div>
        {% if settings.display_more and settings.more_text %}
          <a href="{{ settings.products.url or url_for('list_products') }}" class="asrar-section-link">
            {{ settings.more_text }}
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" class="rtl:rotate-180" aria-hidden="true">
              <path d="M1 7h12M8 2l5 5-5 5" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {% endif %}
      </div>

      {# Products Grid #}
      <div class="asrar-products-grid">
        {% for product in settings.products.results %}
          {% with index=loop.index0, is_priority=(loop.first and settings.order <= 2) %}
            {% include 'components/products/product-card.jinja' %}
          {% endwith %}
        {% endfor %}
      </div>

    </div>
  </section>
{% endif %}
