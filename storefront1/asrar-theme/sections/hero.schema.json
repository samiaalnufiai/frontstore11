{
  "template": "sections/hero.jinja",
  "name": {
    "ar": "البانر الرئيسي",
    "en": "Hero Banner"
  },
  "settings": [
    {
      "id": "is_primary_hero",
      "type": "checkbox",
      "label": { "ar": "البانر الرئيسي (H1)", "en": "Primary Hero (H1)" },
      "default": true
    },
    {
      "id": "background_image",
      "type": "image",
      "label": { "ar": "صورة الخلفية (سطح المكتب)", "en": "Background Image (Desktop)" },
      "info": { "ar": "1920 × 900 بكسل", "en": "1920 × 900 pixels" }
    },
    {
      "id": "background_image_mobile",
      "type": "image",
      "label": { "ar": "صورة الخلفية (موبايل)", "en": "Background Image (Mobile)" },
      "info": { "ar": "828 × 900 بكسل", "en": "828 × 900 pixels" }
    },
    {
      "id": "background_position",
      "type": "select",
      "label": { "ar": "موضع الخلفية", "en": "Background Position" },
      "options": [
        { "value": "center", "label": { "ar": "وسط", "en": "Center" } },
        { "value": "top", "label": { "ar": "أعلى", "en": "Top" } },
        { "value": "bottom", "label": { "ar": "أسفل", "en": "Bottom" } },
        { "value": "right", "label": { "ar": "يمين", "en": "Right" } },
        { "value": "left", "label": { "ar": "يسار", "en": "Left" } }
      ],
      "default": "center"
    },
    {
      "id": "badge_text",
      "type": "text",
      "label": { "ar": "نص العنوان الصغير", "en": "Eyebrow Text" },
      "default": "أسرار العناية"
    },
    {
      "id": "heading",
      "type": "text",
      "label": { "ar": "العنوان الرئيسي", "en": "Main Heading" },
      "default": "بعض الوصفات لا تُورث ... بل تُختار من يفهمها"
    },
    {
      "id": "description",
      "type": "textarea",
      "label": { "ar": "الوصف", "en": "Description" },
      "default": "خلطات طبيعية، ملفات رقمية مُعتنى بها. من تجربة، وملاحظة، وفهم عميق لاحتياجات الشعر والبشرة."
    },
    {
      "id": "button_text",
      "type": "text",
      "label": { "ar": "نص الزر الأول", "en": "Primary Button Text" },
      "default": "اكتشفي الملفات"
    },
    {
      "id": "button_url",
      "type": "url",
      "label": { "ar": "رابط الزر الأول", "en": "Primary Button URL" }
    },
    {
      "id": "secondary_button_text",
      "type": "text",
      "label": { "ar": "نص الزر الثاني", "en": "Secondary Button Text" }
    },
    {
      "id": "secondary_button_url",
      "type": "url",
      "label": { "ar": "رابط الزر الثاني", "en": "Secondary Button URL" }
    },
    {
      "id": "min_height_mobile",
      "type": "range",
      "label": { "ar": "الارتفاع الأدنى (موبايل)", "en": "Min Height (Mobile)" },
      "min": 400, "max": 1000, "step": 50, "unit": "px", "default": 700
    },
    {
      "id": "min_height_desktop",
      "type": "range",
      "label": { "ar": "الارتفاع الأدنى (سطح المكتب)", "en": "Min Height (Desktop)" },
      "min": 500, "max": 1100, "step": 50, "unit": "px", "default": 760
    }
  ]
}
