{% extends "layout.jinja" %}
{% block content %}
<div style="min-height:60vh;display:flex;align-items:center;justify-content:center;padding:4rem 1.25rem">
  <div class="asrar-empty">
    <div style="font-family:var(--font-display);font-size:6rem;font-weight:300;color:var(--gold);opacity:0.4;line-height:1">404</div>
    <h1 class="asrar-empty-title" style="font-size:1.5rem">{{ _('Page Not Found') }}</h1>
    <p class="asrar-empty-desc">{{ _('The page you are looking for does not exist.') }}</p>
    <a href="{{ url_for('home') }}" class="asrar-btn asrar-btn-gold asrar-btn-lg" style="margin-top:1.5rem">{{ _('Go Home') }}</a>
  </div>
</div>
{% endblock %}
