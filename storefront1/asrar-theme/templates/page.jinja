{% extends "layout.jinja" %}
{% block content %}

<div style="background:var(--background-elevated);border-bottom:1px solid var(--border);padding:2.5rem 1.25rem 2rem">
  <div class="asrar-container" style="max-width:860px;margin-inline:auto">
    <nav class="asrar-breadcrumb" style="margin-bottom:1rem">
      <a href="{{ url_for('home') }}">{{ _('Home') }}</a>
      <span class="asrar-breadcrumb-sep rtl:rotate-180">›</span>
      <span>{{ page.title }}</span>
    </nav>
    <h1 style="font-family:var(--font-display);font-size:clamp(1.75rem,3vw,2.5rem);font-weight:400;color:var(--foreground);margin:0">{{ page.title }}</h1>
  </div>
</div>

<div class="asrar-section">
  <div class="asrar-container" style="max-width:860px;margin-inline:auto">
    <div style="font-size:0.9375rem;line-height:1.85;color:var(--muted-foreground)">
      {{ page.content | safe }}
    </div>
  </div>
</div>

{% endblock %}
