{% extends "layout.jinja" %}
{% block content %}

<div style="background:var(--background-elevated);border-bottom:1px solid var(--border);padding:2.5rem 1.25rem 2rem">
  <div class="asrar-container" style="max-width:860px;margin-inline:auto">
    <h1 style="font-family:var(--font-display);font-size:clamp(1.75rem,3vw,2.5rem);font-weight:400;color:var(--foreground);margin:0">{{ _('Shipping & Payment') }}</h1>
  </div>
</div>

<div class="asrar-section">
  <div class="asrar-container" style="max-width:860px;margin-inline:auto;display:flex;flex-direction:column;gap:3rem">

    {# Shipping #}
    {% if store.settings.checkout.shipping_methods %}
      <div>
        <h2 style="font-family:var(--font-display);font-size:1.375rem;font-weight:400;color:var(--foreground);margin:0 0 1.25rem">{{ _('Shipping Methods') }}</h2>
        <div style="display:flex;flex-direction:column;gap:0.75rem">
          {% for method in store.settings.checkout.shipping_methods %}
            <div style="display:flex;align-items:center;gap:1rem;padding:1rem 1.25rem;background:var(--background-elevated);border:1px solid var(--border);border-radius:var(--radius-md)">
              {% if method.icon %}
                <img src="{{ image_url(method.icon, w=80, h=48, q=90) }}" alt="{{ method.name }}" style="height:2rem;width:auto;object-fit:contain;opacity:0.8" loading="lazy"/>
              {% endif %}
              <span style="font-size:0.9rem;color:var(--foreground)">{{ method.name }}</span>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    {# Payment #}
    {% if store.settings.checkout.payment_methods %}
      <div>
        <h2 style="font-family:var(--font-display);font-size:1.375rem;font-weight:400;color:var(--foreground);margin:0 0 1.25rem">{{ _('Payment Methods') }}</h2>
        <div style="display:flex;flex-wrap:wrap;gap:0.75rem">
          {% for method in store.settings.checkout.payment_methods %}
            <div style="display:flex;align-items:center;gap:0.75rem;padding:0.875rem 1.125rem;background:var(--background-elevated);border:1px solid var(--border);border-radius:var(--radius-md)">
              {% if method.icon %}
                <img src="{{ image_url(method.icon, w=80, h=48, q=90) }}" alt="{{ method.name }}" style="height:1.75rem;width:auto;object-fit:contain" loading="lazy"/>
              {% endif %}
              <span style="font-size:0.875rem;color:var(--foreground)">{{ method.name }}</span>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}

  </div>
</div>

{% endblock %}
