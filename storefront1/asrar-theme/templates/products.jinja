{% extends "layout.jinja" %}
{% block content %}

<div style="background:var(--background-elevated);border-bottom:1px solid var(--border);padding:2.5rem 1.25rem 2rem">
  <div class="asrar-container">
    <nav class="asrar-breadcrumb" style="margin-bottom:1rem">
      <a href="{{ url_for('home') }}">{{ _('Home') }}</a>
      <span class="asrar-breadcrumb-sep rtl:rotate-180">›</span>
      <span>{{ _('All Products') }}</span>
    </nav>
    <h1 style="font-family:var(--font-display);font-size:clamp(1.75rem,3vw,2.5rem);font-weight:400;color:var(--foreground);margin:0">{{ _('All Products') }}</h1>
  </div>
</div>

<div class="asrar-section">
  <div class="asrar-container">
    {% if products and products.results %}
      <div class="asrar-products-grid">
        {% for product in products.results %}
          {% with index=loop.index0, is_priority=loop.first %}
            {% include 'components/products/product-card.jinja' %}
          {% endwith %}
        {% endfor %}
      </div>
      {% if products.next or products.previous %}
        <div style="display:flex;justify-content:center;gap:1rem;margin-top:3rem">
          {% if products.previous %}
            <a href="{{ products.previous }}" class="asrar-btn asrar-btn-ghost">← {{ _('Previous') }}</a>
          {% endif %}
          {% if products.next %}
            <a href="{{ products.next }}" class="asrar-btn asrar-btn-ghost">{{ _('Next') }} →</a>
          {% endif %}
        </div>
      {% endif %}
    {% else %}
      <div class="asrar-empty">
        <div class="asrar-empty-icon">✦</div>
        <h2 class="asrar-empty-title">{{ _('No products yet') }}</h2>
      </div>
    {% endif %}
  </div>
</div>

{% endblock %}
