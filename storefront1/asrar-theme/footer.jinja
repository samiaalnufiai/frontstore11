<footer id="footer" class="asrar-footer">
  <div class="asrar-footer-grid">

    {# Brand Column #}
    <div class="asrar-footer-brand">
      {% if settings.logo_logo_desktop or settings.logo_logo_mobile %}
        <img
          src="{{ image_url(settings.logo_logo_desktop or settings.logo_logo_mobile or store.logo, w=220, q=90, f='auto') }}"
          alt="{{ store.name }}"
          class="asrar-logo-img"
          style="margin-bottom:0.875rem"
          loading="lazy"
          width="110" height="44"
        />
      {% elif store.logo %}
        <img
          src="{{ image_url(store.logo, w=220, q=90, f='auto') }}"
          alt="{{ store.name }}"
          class="asrar-logo-img"
          style="margin-bottom:0.875rem"
          loading="lazy"
          width="110" height="44"
        />
      {% else %}
        <span class="asrar-logo-text">{{ store.name }}</span>
      {% endif %}

      <p class="asrar-footer-tagline">{{ settings.about_us_about_us | safe }}</p>

      {# Social Links #}
      <div class="asrar-footer-social">
        {% if store.settings.contact.instagram %}
          <a href="https://www.instagram.com/{{ store.settings.contact.instagram }}" target="_blank" rel="noopener" class="asrar-social-link" aria-label="Instagram">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.9 4.9 0 011.772 1.153 4.9 4.9 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.9 4.9 0 01-1.153 1.772 4.9 4.9 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.9 4.9 0 01-1.772-1.153 4.9 4.9 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.9 4.9 0 011.153-1.772A4.9 4.9 0 015.45 2.525c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.1 3.1 0 00-.748-1.15 3.1 3.1 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z"/>
            </svg>
          </a>
        {% endif %}
        {% if store.settings.contact.tiktok %}
          <a href="https://www.tiktok.com/@{{ store.settings.contact.tiktok }}" target="_blank" rel="noopener" class="asrar-social-link" aria-label="TikTok">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.59 6.69a4.83 4.83 0 01-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 01-5.2 1.74 2.89 2.89 0 012.31-4.64 2.93 2.93 0 01.88.13V9.4a6.84 6.84 0 00-1-.05A6.33 6.33 0 005 20.1a6.34 6.34 0 0010.86-4.43v-7a8.16 8.16 0 004.77 1.52v-3.4a4.85 4.85 0 01-1-.1z"/>
            </svg>
          </a>
        {% endif %}
        {% if store.settings.contact.snapchat %}
          <a href="https://www.snapchat.com/add/{{ store.settings.contact.snapchat }}" target="_blank" rel="noopener" class="asrar-social-link" aria-label="Snapchat">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C8.5 2 6 4.5 6 7.5v1H4l.5 2.5c1 0 2 .5 2 1.5 0 .5-.5 2.5-3 3l.5 1.5c2 .5 3.5 1.5 4 3h1c.5-1 1.5-1.5 3-1.5s2.5.5 3 1.5h1c.5-1.5 2-2.5 4-3l.5-1.5c-2.5-.5-3-2.5-3-3 0-1 1-1.5 2-1.5L20 8.5h-2v-1C18 4.5 15.5 2 12 2z"/>
            </svg>
          </a>
        {% endif %}
        {% if store.settings.contact.twitter %}
          <a href="https://twitter.com/{{ store.settings.contact.twitter }}" target="_blank" rel="noopener" class="asrar-social-link" aria-label="X/Twitter">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M13.682 10.622L20.239 3h-1.554L12.992 9.618 8.445 3H3.2l6.877 10.007L3.2 21h1.554l6.007-6.987L15.569 21h5.245l-7.132-10.378z"/>
            </svg>
          </a>
        {% endif %}
        {% if store.settings.contact.email %}
          <a href="mailto:{{ store.settings.contact.email }}" class="asrar-social-link" aria-label="Email">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="M2 7l10 8 10-8" stroke-linecap="round"/>
            </svg>
          </a>
        {% endif %}
      </div>
    </div>

    {# Link Groups #}
    {% for group in settings.link_groups_items or [] %}
      {% if not group.hide and group.links %}
        <div>
          {% if group.title %}
            <h3 class="asrar-footer-col-title">{{ group.title }}</h3>
          {% endif %}
          <ul class="asrar-footer-links" role="list">
            {% for link in group.links %}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    {% endfor %}

    {# Contact #}
    <div>
      <h3 class="asrar-footer-col-title">
        {{ settings.contact_info_contact_info_title | default(_('Contact us')) }}
      </h3>
      <div class="asrar-footer-contact">
        {% if store.settings.contact.email %}
          <a href="mailto:{{ store.settings.contact.email }}" class="asrar-footer-contact-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="4" width="20" height="16" rx="2"/>
              <path d="M2 7l10 8 10-8"/>
            </svg>
            {{ store.settings.contact.email }}
          </a>
        {% endif %}
        {% if store.settings.contact.phone %}
          <a href="tel:{{ store.settings.contact.phone }}" class="asrar-footer-contact-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M3 5a2 2 0 012-2h3l2 4.5-2 2c1 2 3 4 5 5l2-2 4.5 2v3a2 2 0 01-2 2C8.5 22 2 15.5 2 7z" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            {{ store.settings.contact.phone }}
          </a>
        {% endif %}
      </div>
    </div>

  </div>

  {# Footer Bottom #}
  <div class="asrar-footer-bottom">
    <p class="asrar-footer-copy">
      {{ store.settings.branding.copyrights | safe }}
    </p>
    <div class="asrar-footer-payments">
      {% for payment_method in store.settings.checkout.payment_methods %}
        <img
          src="{{ image_url(payment_method.icon, w=64, h=40, q=100) }}"
          alt="{{ payment_method.name }}"
          loading="lazy"
        />
      {% endfor %}
      {% if store.settings.general.tax_settings.is_certificate_visible %}
        <img
          src="{{ image_url(('images/vat-certificate.png' | asset_url), w=108, q=85, f='auto') }}"
          alt="{{ _('VAT Certificate') }}"
          loading="lazy"
        />
      {% endif %}
      {% if store.settings.general.tax_settings.tax_number %}
        <span style="font-size:0.7rem;color:var(--muted)">
          {{ _('VAT number:') }} {{ store.settings.general.tax_settings.tax_number }}
        </span>
      {% endif %}
    </div>
  </div>

</footer>
